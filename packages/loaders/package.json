{
  "name": "@oxygenui-design/loaders",
  "version": "0.1.0",
  "description": "Healthcare page loaders as dependency-free custom elements. Heartbeat, rhythm strip, breath, helix, and infusion — themeable, accessible, and reduced-motion aware. Works in React, Vue, Angular, Svelte, or plain HTML.",
  "license": "MIT",
  "homepage": "https://oxygenui.design/components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/oxygenui.git",
    "directory": "packages/loaders"
  },
  "keywords": [
    "loader",
    "spinner",
    "loading",
    "progress",
    "custom-elements",
    "web-components",
    "healthcare",
    "ecg",
    "heartbeat",
    "accessibility",
    "react",
    "vue",
    "angular",
    "svelte"
  ],
  "type": "module",
  "//sideEffects": "Each entry point DEFINES a custom element. Marking this package side-effect-free would let a bundler drop the import and leave the page full of undefined elements.",
  "sideEffects": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pulse": "./src/pulse.ts",
    "./rhythm": "./src/rhythm.ts",
    "./breath": "./src/breath.ts",
    "./helix": "./src/helix.ts",
    "./infusion": "./src/infusion.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./pulse": {
        "types": "./dist/pulse.d.ts",
        "default": "./dist/pulse.js"
      },
      "./rhythm": {
        "types": "./dist/rhythm.d.ts",
        "default": "./dist/rhythm.js"
      },
      "./breath": {
        "types": "./dist/breath.d.ts",
        "default": "./dist/breath.js"
      },
      "./helix": {
        "types": "./dist/helix.d.ts",
        "default": "./dist/helix.js"
      },
      "./infusion": {
        "types": "./dist/infusion.d.ts",
        "default": "./dist/infusion.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "node scripts/require-pnpm.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-tarball": "node scripts/check-tarball.mjs"
  },
  "devDependencies": {
    "@oxygenui-design/tsconfig": "workspace:*",
    "jsdom": "^30",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
