{
  "name": "@zoblocks/tokens",
  "version": "0.1.0",
  "description": "Zoblocks design tokens: semantic clinical status, density modes, light/dark themes.",
  "license": "MIT",
  "homepage": "https://zoblocks.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/zoblocks.git",
    "directory": "packages/tokens"
  },
  "keywords": [
    "design-tokens",
    "healthcare",
    "css-variables",
    "tailwind"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./zoblocks-tokens.css": "./src/zoblocks-tokens.css",
    "./tailwind.css": "./src/tailwind.css",
    "./tokens.json": "./src/tokens.json",
    "./contrast.json": "./src/contrast.json",
    ".": "./src/tokens.ts",
    "./validate": "./src/validate/index.ts",
    "./surface": "./src/surface.ts",
    "./package.json": "./package.json",
    "./tokens/*": "./tokens/*"
  },
  "files": [
    "dist",
    "src",
    "tokens",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/tokens.js",
    "types": "./dist/tokens.d.ts",
    "exports": {
      ".": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "./validate": {
        "types": "./dist/validate/index.d.ts",
        "default": "./dist/validate/index.js"
      },
      "./surface": {
        "types": "./dist/surface.d.ts",
        "default": "./dist/surface.js"
      },
      "./zoblocks-tokens.css": "./src/zoblocks-tokens.css",
      "./tailwind.css": "./src/tailwind.css",
      "./tokens.json": "./src/tokens.json",
      "./contrast.json": "./src/contrast.json",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "node scripts/require-pnpm.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-tarball": "node scripts/check-tarball.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "main": "./src/tokens.ts",
  "types": "./src/tokens.ts",
  "//publishConfig": "main/types/exports are rewritten to ./dist at publish time. That rewrite is a pnpm feature — publishing with npm ships raw TypeScript, which is exactly what 0.1.0 did.",
  "devDependencies": {
    "@zoblocks/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
