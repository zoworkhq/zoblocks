    "recording": {
      "$value": "{ref.red.500}",
      "$description": "The capture tell. The one red in the system that is not an alarm: fifty years of cameras, tape decks and voice-memo apps have made a red dot mean recording, and fighting that convention costs more than the collision does. Deliberately one step off status.critical rather than equal to it, so an alert raised DURING a capture is still the more urgent thing on screen \u2014 the pair is checked against each other, not only against the background."
    },
    "recording-bg": {
      "$value": "{ref.tint.critical.bg}"
    },
