{
  "name": "@oxygenui-design/fhir",
  "version": "0.1.1",
  "description": "Narrow FHIR R4 type contracts and pure read helpers for healthcare UI. Zero runtime dependencies.",
  "license": "MIT",
  "homepage": "https://oxygenui.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/oxygenui.git",
    "directory": "packages/fhir"
  },
  "keywords": [
    "fhir",
    "fhir-r4",
    "healthcare",
    "hl7",
    "typescript",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepublishOnly": "node scripts/require-pnpm.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@oxygenui-design/tsconfig": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
