{
  "name": "@zoblocks/theme",
  "version": "0.2.1",
  "description": "Customer themes at runtime: the document model, the ramp generator, the three-point validation, and the CSS payload a published theme is served as.",
  "license": "MIT",
  "homepage": "https://zoblocks.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/zoblocks.git",
    "directory": "packages/theme"
  },
  "keywords": [
    "design-tokens",
    "theming",
    "white-label",
    "multi-tenant",
    "css-variables",
    "healthcare"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./vision": "./src/vision.ts",
    "./logo": "./src/logo.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./logo": {
        "types": "./dist/logo.d.ts",
        "default": "./dist/logo.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../tokens/scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zoblocks/bridge-antd": "workspace:*",
    "@zoblocks/bridge-core": "workspace:*",
    "@zoblocks/bridge-mui": "workspace:*",
    "@zoblocks/tokens": "workspace:*",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@types/react": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@zoblocks/bridge-antd": "workspace:*",
    "@zoblocks/bridge-mui": "workspace:*",
    "@zoblocks/tsconfig": "workspace:*",
    "jsdom": "^30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
