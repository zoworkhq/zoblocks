{
  "extends": "@oxygenui-design/tsconfig/react-library.json",
  "compilerOptions": {
    // Restated locally: paths in an extended config resolve relative to the
    // file that declares them, so inheriting these from the shared config
    // would point at packages/tsconfig/src.
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
