{
  "name": "@zoblocks/component-meta",
  "version": "0.1.0",
  "private": true,
  "description": "Schema and types for per-component metadata. The single source of truth every generated artifact is derived from.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
