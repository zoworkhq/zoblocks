{
  "name": "@zoblocks/clinical-note-core",
  "version": "0.2.0",
  "description": "The engine behind ZoBlocks's ClinicalNote. Coded sections, per-range provenance, a composable sign gate, and deterministic FHIR/text serialization — no React, no DOM.",
  "license": "MIT",
  "homepage": "https://zoblocks.design/components/clinical-note",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/zoblocks.git",
    "directory": "packages/clinical-note-core"
  },
  "keywords": [
    "clinical-note",
    "ehr",
    "emr",
    "prosemirror",
    "healthcare",
    "fhir",
    "loinc",
    "provenance",
    "documentation"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "prosemirror-model": "^1.25.1",
    "prosemirror-transform": "^1.10.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "@zoblocks/tsconfig": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
