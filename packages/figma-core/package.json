{
  "name": "@zoblocks/figma-core",
  "version": "0.1.0",
  "description": "ZoBlocks themes as Figma variable plans. Pure — no figma.*, no DOM, no network.",
  "license": "MIT",
  "homepage": "https://zoblocks.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/zoblocks.git",
    "directory": "packages/figma-core"
  },
  "keywords": [
    "figma",
    "figma-variables",
    "design-tokens",
    "design-system",
    "healthcare"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../tokens/scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zoblocks/tokens": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "@zoblocks/tsconfig": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
