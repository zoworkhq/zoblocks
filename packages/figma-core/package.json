{
  "name": "@zoblocks/figma-core",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Zoblocks themes as Figma variable plans. Pure — no figma.*, no DOM, no network.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../tokens/scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zoblocks/tokens": "workspace:*"
  },
  "devDependencies": {
    "@zoblocks/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
