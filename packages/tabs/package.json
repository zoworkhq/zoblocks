{
  "name": "@oxygenui-design/tabs",
  "version": "0.1.0",
  "description": "Tabs that know what they are. Four semantic modes \u2014 view switch, navigation, form value, wizard \u2014 across eleven skins, with the WAI-ARIA keyboard model, priority-plus overflow and WCAG 2.2 AA states.",
  "license": "MIT",
  "homepage": "https://oxygenui.design/components/tabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/oxygenui.git",
    "directory": "packages/tabs"
  },
  "keywords": [
    "tabs",
    "tablist",
    "segmented-control",
    "radiogroup",
    "antd",
    "ant-design",
    "react",
    "accessibility",
    "wcag",
    "aria",
    "rtl",
    "healthcare"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./antd": "./src/antd.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.stories.tsx"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./antd": {
        "types": "./dist/antd.d.ts",
        "default": "./dist/antd.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@oxygenui-design/tabs-core": "workspace:*"
  },
  "peerDependencies": {
    "antd": ">=5.20.0 || >=6.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oxygenui-design/component-meta": "workspace:*",
    "@oxygenui-design/fixtures": "workspace:*",
    "@oxygenui-design/tabs-testing": "workspace:*",
    "@oxygenui-design/tsconfig": "workspace:*",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "antd": "^6.6.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
