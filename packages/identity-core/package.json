{
  "name": "@oxygenui-design/identity-core",
  "version": "0.1.0",
  "description": "The identity engine behind Oxygen's patient avatar, chip and banner. Name resolution, deterministic swatches, script-aware initials, and the disambiguation pass that keeps two patients with one name apart — no React, no DOM.",
  "license": "MIT",
  "homepage": "https://oxygenui.design/components/patient-banner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/oxygenui.git",
    "directory": "packages/identity-core"
  },
  "keywords": [
    "fhir",
    "patient",
    "patient-identification",
    "healthcare",
    "avatar",
    "initials",
    "accessibility",
    "wcag"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@oxygenui-design/fhir": "workspace:*"
  },
  "devDependencies": {
    "@oxygenui-design/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
