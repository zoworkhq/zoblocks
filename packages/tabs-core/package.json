{
  "name": "@zoblocks/tabs-core",
  "version": "0.2.0",
  "description": "The selection engine behind ZoBlocks's tab system. Semantic modes, the WAI-ARIA keyboard model, priority-plus overflow and indicator geometry — no React, no DOM, no dependencies.",
  "license": "MIT",
  "homepage": "https://zoblocks.design/components/tabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/zoblocks.git",
    "directory": "packages/tabs-core"
  },
  "keywords": [
    "tabs",
    "tablist",
    "segmented-control",
    "radiogroup",
    "headless",
    "accessibility",
    "wcag",
    "aria",
    "keyboard-navigation",
    "healthcare"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "@zoblocks/tsconfig": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
