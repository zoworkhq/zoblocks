{
  "name": "@zoblocks/bridge-core",
  "version": "0.2.1",
  "description": "The theme-bridge contract: how a UI framework's resolved theme becomes ZoBlocks's component token surface. No framework, no React, no DOM.",
  "license": "MIT",
  "homepage": "https://zoblocks.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/zoblocks.git",
    "directory": "packages/bridge-core"
  },
  "keywords": [
    "design-tokens",
    "theming",
    "ant-design",
    "material-ui",
    "css-variables",
    "healthcare"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../tokens/scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zoblocks/tokens": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@types/react": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@zoblocks/tsconfig": "workspace:*",
    "jsdom": "^30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
