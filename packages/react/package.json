{
  "name": "@oxygenui-design/react",
  "version": "0.1.0",
  "description": "Healthcare React components typed for the states a demo would skip. Accessible, themeable, reduced-motion aware, with zero runtime dependencies.",
  "license": "MIT",
  "homepage": "https://oxygenui.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/oxygenui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "healthcare",
    "design-system",
    "components",
    "accessibility",
    "wcag",
    "fhir",
    "loader",
    "spinner"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "//peerDependencies": "React is a peer, never a dependency — a component library that bundles its own React gives the host two copies and breaks every hook.",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "node scripts/require-pnpm.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs && node scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check-tarball": "node scripts/check-tarball.mjs"
  },
  "devDependencies": {
    "@oxygenui-design/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/react": "^19.0.2",
    "jsdom": "^25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
