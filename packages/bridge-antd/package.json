{
  "name": "@zoblocks/bridge-antd",
  "version": "0.1.0",
  "description": "Theme bridge for Ant Design: reads a host's resolved antd theme and writes Zoblocks's component token surface, so Zoblocks components take the host's design language without importing antd.",
  "license": "MIT",
  "homepage": "https://zoblocks.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/zoblocks.git",
    "directory": "packages/bridge-antd"
  },
  "keywords": [
    "ant-design",
    "antd",
    "design-tokens",
    "theming",
    "css-variables",
    "react",
    "healthcare"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./definition": "./src/map.ts",
    "./inverse": "./src/inverse.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./definition": {
        "types": "./dist/map.d.ts",
        "default": "./dist/map.js"
      },
      "./package.json": "./package.json",
      "./inverse": "./dist/inverse.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../tokens/scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zoblocks/bridge-core": "workspace:*"
  },
  "peerDependencies": {
    "antd": "^6.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@zoblocks/tsconfig": "workspace:*",
    "@testing-library/react": "^16",
    "@types/react": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "antd": "^6.6.0",
    "jsdom": "^30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
