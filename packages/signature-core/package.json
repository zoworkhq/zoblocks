{
  "name": "@zoblocks/signature-core",
  "version": "0.2.0",
  "description": "The capture engine behind ZoBlocks's signature component. Stroke model, smoothing, export, and the outcome union — no React, no DOM required, no dependencies.",
  "license": "MIT",
  "homepage": "https://zoblocks.design/components/signature",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/zoblocks.git",
    "directory": "packages/signature-core"
  },
  "keywords": [
    "signature",
    "esignature",
    "signature-pad",
    "healthcare",
    "fhir",
    "consent",
    "accessibility",
    "wcag"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "@zoblocks/tsconfig": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
