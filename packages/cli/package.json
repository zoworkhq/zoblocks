{
  "name": "@oxygenui-design/cli",
  "version": "0.1.0",
  "description": "Installs Oxygen UI components into your repository. Resolves the Oxygen registry, writes the source, and tells you what it touched.",
  "license": "MIT",
  "homepage": "https://oxygenui.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/oxygenui.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "oxygen",
    "oxygenui",
    "healthcare",
    "fhir",
    "design-system",
    "registry",
    "cli"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "oxygen": "./bin/oxygen.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "//dependencies": "None, on purpose. ADR 0009 makes every runtime dependency an architectural decision, and an install CLI is the worst place to spend that budget: it runs with write access to a customer's repository, so its transitive tree is the part a vendor security review reads first. Node 20 supplies fetch, parseArgs, and styleText; the registry client, the config reader, and the writer are ours.",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@oxygenui-design/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
