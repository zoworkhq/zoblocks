{
  "name": "@oxygenui-design/identity",
  "version": "0.1.0",
  "description": "Patient identity for Ant Design: an avatar that says why a photo is missing, a chip that keeps two patients with one name apart, and a banner that knows what it is guarding. WCAG 2.2 AA, FHIR-shaped.",
  "license": "MIT",
  "homepage": "https://oxygenui.design/components/patient-banner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/oxygenui.git",
    "directory": "packages/identity"
  },
  "keywords": [
    "antd",
    "ant-design",
    "patient",
    "patient-banner",
    "patient-identification",
    "avatar",
    "healthcare",
    "fhir",
    "accessibility",
    "wcag",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.tsx"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@oxygenui-design/identity-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@oxygenui-design/fhir": "workspace:*",
    "@oxygenui-design/tsconfig": "workspace:*",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "jsdom": "^30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
