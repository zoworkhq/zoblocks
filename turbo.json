{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    // Builds workspace dependencies first, like every other task here. The docs
    // app aliases the NodeNext packages (tabs, consult) to their `dist` — see
    // apps/docs/next.config.ts — so without a build those specifiers resolve
    // into `src`, hit a `./Tabs.js` import that only Node can follow, and the
    // whole site 500s. The error names a file that exists on disk, which makes
    // it read as a broken component rather than a missing build.
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // No artefacts. `test` runs `vitest run`; only `test:coverage` passes
      // --coverage, so declaring coverage/** here made turbo warn on every
      // package whose suite produced nothing — noise on each CI run, and the
      // kind that trains people to skim past warnings.
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
