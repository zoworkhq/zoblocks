{
  // Path mappings live in tsconfig.generated.json, produced by `pnpm gen`.
  //
  // Registry components import "@/lib/utils" and "@/components/oxygen/*"
  // because that is where the Oxygen CLI writes them in the consumer's project,
  // so those specifiers have to resolve here too. That map used to be
  // maintained by hand, with a comment asking authors to add an entry per
  // component; four were missing and nothing reported it, because no workspace
  // task typechecked this config. It is generated now, and `pnpm typecheck`
  // runs it.
  "extends": ["./packages/tsconfig/base.json", "./tsconfig.generated.json"],
  "compilerOptions": {
    "noEmit": true,
    // jest-dom's matchers are added at runtime by test/setup.ts. TypeScript
    // needs the augmentation listed explicitly, or every `toBeInTheDocument`
    // is an error here while the tests themselves pass.
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "scripts/**/*.ts",
    "registry/**/*.ts",
    "registry/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
