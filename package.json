{
  "name": "oxygenui",
  "version": "0.0.0",
  "private": true,
  "description": "Healthcare UI components with FHIR-shaped data contracts, delivered as a shadcn registry.",
  "homepage": "https://oxygenui.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoworkhq/oxygenui.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings 8",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "test": "turbo run test && pnpm test:registry",
    "test:registry": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "turbo run test:coverage && vitest run --coverage",
    "gen": "tsx scripts/gen/index.ts",
    "gen:check": "tsx scripts/gen/index.ts --check",
    "gen:component": "tsx scripts/gen/scaffold.ts",
    "registry:build": "tsx scripts/gen/index.ts",
    "registry:check": "tsx scripts/gen/index.ts --check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "a11y": "tsx scripts/a11y.ts",
    "gen:strict": "tsx scripts/gen/index.ts --strict",
    "size": "size-limit",
    "deps": "depcruise --config .dependency-cruiser.cjs packages registry scripts --output-type err",
    "publint": "pnpm -r --filter \"./packages/*\" exec publint --strict || true",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:update": "playwright test --grep @vrt --update-snapshots",
    "e2e:ci": "playwright test --grep-invert @vrt",
    "e2e:vrt": "playwright test --grep @vrt"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/cli": "^4.12.1",
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@oxygenui-design/component-meta": "workspace:*",
    "@oxygenui-design/eslint-plugin": "workspace:^",
    "@oxygenui-design/fhir": "workspace:*",
    "@oxygenui-design/fixtures": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.12.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^25",
    "lint-staged": "^17.3.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^13.0.3",
    "tailwind-merge": "^2.5.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "//overrides": "Transitive advisories we cannot reach through a direct dependency. Each entry is the patched floor from the advisory, not a pin \u2014 remove it once the parent package ships the fix itself. `pnpm audit --audit-level=high` in CI is what tells us when that has happened.",
    "overrides": {
      "nanoid@<3.3.18": ">=3.3.18"
    }
  },
  "lint-staged": {
    "//": "--no-warn-ignored because lint-staged passes every staged file matching the glob, including generated artifacts that .eslintignore excludes. ESLint then warns 'File ignored because of a matching ignore pattern', and --max-warnings 0 turns that warning into a failed commit \u2014 so staging a regenerated catalog.ts or next-env.d.ts blocked the commit for a file nobody is meant to lint.",
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
