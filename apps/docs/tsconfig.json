{
  "extends": "@oxygenui-design/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/registry/*": ["../../registry/*"],
      // Registry components import each other, and their shared library, by the
      // paths the Oxygen CLI writes in a consumer's project. Mapped back to the
      // registry source so the previews render the real files, unedited.
      //
      // The per-component entries are generated — see tsconfig.generated.json,
      // spread below. They were hand-kept until three of ten were mapped and
      // the rest were simply unimportable, which is why several components had
      // no live preview: not a decision, a missing line in this file.
      "@/lib/oxygen-loader": ["../../registry/oxygen/lib/loader.tsx"],
      "@/lib/oxygen-switch": ["../../registry/oxygen/lib/switch.tsx"],
      "@/lib/oxygen-accordion": ["../../registry/oxygen/lib/accordion-core.tsx"],
      "@/lib/oxygen-clinical-note": ["../../registry/oxygen/lib/clinical-note.tsx"],
      "@/lib/oxygen-clinical-status": ["../../registry/oxygen/lib/clinical-status.ts"],
      "@/lib/oxygen-result-value": ["../../registry/oxygen/lib/result-value.ts"],
      "@/lib/oxygen-allergy": ["../../registry/oxygen/lib/allergy.ts"],
      "@/lib/oxygen-risk": ["../../registry/oxygen/lib/risk.ts"],
      "@/lib/oxygen-provenance": ["../../registry/oxygen/lib/provenance.ts"],
      "@/lib/oxygen-trend": ["../../registry/oxygen/lib/trend.ts"],
      "@/lib/oxygen-clock": ["../../registry/oxygen/lib/clock.ts"],
      "@/lib/oxygen-presence": ["../../registry/oxygen/lib/presence.ts"],
      "@/lib/oxygen-chart-header": ["../../registry/oxygen/lib/chart-header.ts"],
      "@/lib/oxygen-workspace": ["../../registry/oxygen/lib/workspace.ts"],
      "@/lib/oxygen-palette": ["../../registry/oxygen/lib/palette.ts"],
      "@/lib/timeline-core": ["../../registry/oxygen/lib/timeline-core.ts"],
      "@/lib/timeline-fhir": ["../../registry/oxygen/lib/timeline-fhir.ts"],
      "@/components/oxygen/clinical-note": [
        "../../registry/oxygen/clinical-note/clinical-note.tsx"
      ],
      "@/components/oxygen/clinical-status": [
        "../../registry/oxygen/clinical-status/clinical-status.tsx"
      ],
      "@/components/oxygen/result-value": ["../../registry/oxygen/result-value/result-value.tsx"],
      "@/components/oxygen/allergy-chip": ["../../registry/oxygen/allergy-chip/allergy-chip.tsx"],
      "@/components/oxygen/risk-indicator": [
        "../../registry/oxygen/risk-indicator/risk-indicator.tsx"
      ],
      "@/components/oxygen/provenance-chip": [
        "../../registry/oxygen/provenance-chip/provenance-chip.tsx"
      ],
      "@/components/oxygen/trend-indicator": [
        "../../registry/oxygen/trend-indicator/trend-indicator.tsx"
      ],
      "@/components/oxygen/care-team-presence": [
        "../../registry/oxygen/care-team-presence/care-team-presence.tsx"
      ],
      "@/components/oxygen/chart-header": ["../../registry/oxygen/chart-header/chart-header.tsx"],
      "@/components/oxygen/recent-patient-stack": [
        "../../registry/oxygen/recent-patient-stack/recent-patient-stack.tsx"
      ],
      "@/components/oxygen/chart-command-palette": [
        "../../registry/oxygen/chart-command-palette/chart-command-palette.tsx"
      ],
      "@/components/oxygen/accordion": ["../../registry/oxygen/accordion/accordion.tsx"],
      "@/components/oxygen/care-timeline": [
        "../../registry/oxygen/care-timeline/care-timeline.tsx"
      ],
      "@/components/oxygen/timeline": ["../../registry/oxygen/timeline/timeline.tsx"],
      "@/components/oxygen/breath-loader": [
        "../../registry/oxygen/breath-loader/breath-loader.tsx"
      ],
      "@/components/oxygen/chart-accordion": [
        "../../registry/oxygen/chart-accordion/chart-accordion.tsx"
      ],
      "@/components/oxygen/copilot": ["../../registry/oxygen/copilot/copilot.tsx"],
      "@/components/oxygen/helix-loader": ["../../registry/oxygen/helix-loader/helix-loader.tsx"],
      "@/components/oxygen/infusion-loader": [
        "../../registry/oxygen/infusion-loader/infusion-loader.tsx"
      ],
      "@/components/oxygen/pulse-loader": ["../../registry/oxygen/pulse-loader/pulse-loader.tsx"],
      "@/components/oxygen/rhythm-loader": [
        "../../registry/oxygen/rhythm-loader/rhythm-loader.tsx"
      ],
      "@/components/oxygen/safety-plan": ["../../registry/oxygen/safety-plan/safety-plan.tsx"],
      "@/components/oxygen/switch": ["../../registry/oxygen/switch/switch.tsx"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
