{
  "extends": "@oxygenui-design/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/registry/*": ["../../registry/*"],
      // Registry components import each other, and their shared library, by the
      // paths the shadcn CLI writes in a consumer's project. Mapped back to the
      // registry source so the previews render the real files, unedited.
      "@/lib/oxygen-loader": ["../../registry/oxygen/lib/loader.tsx"],
      "@/lib/oxygen-switch": ["../../registry/oxygen/lib/switch.tsx"],
      "@/components/oxygen/rhythm-loader": ["../../registry/oxygen/rhythm-loader/rhythm-loader.tsx"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
