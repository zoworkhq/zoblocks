# Copy to .env.local and fill in. Never commit the filled version.

# MongoDB connection string. hq shares the cluster the marketing site uses, but
# never its database: the app always opens the database named below, whatever
# path segment this URL carries. Copy the value from the theweb Vercel project.
DATABASE_URL="mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority"

# Optional. Defaults to "hq". Only change it if that name is already taken in
# the cluster by something else.
# HQ_DB_NAME="hq"
