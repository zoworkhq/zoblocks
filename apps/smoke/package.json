{
  "name": "@oxygenui-design/smoke",
  "version": "0.0.0",
  "private": true,
  "description": "Proves the cross-framework claim by building and running the elements under each framework's real compiler.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 6010 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oxygenui-design/loaders": "workspace:*",
    "@oxygenui-design/tokens": "workspace:*"
  },
  "devDependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.1",
    "svelte": "^5.19.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vue": "^3.5.13",
    "zone.js": "^0.15.1"
  }
}
